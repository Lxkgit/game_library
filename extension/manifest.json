{
  "manifest_version": 3,
  "name": "Game Library Steam Connector",
  "version": "1.0.0",
  "description": "为 Game Library 获取公开 Steam 游戏库数据",
  "permissions": [],
  "host_permissions": [
    "https://steamcommunity.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
